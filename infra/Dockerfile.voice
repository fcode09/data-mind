FROM python:3.12-slim
RUN apt-get update && apt-get install -y --no-install-recommends espeak-ng && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY pyproject.toml ./
COPY apps ./apps
RUN pip install --no-cache-dir torch --index-url https://download.pytorch.org/whl/cpu && pip install --no-cache-dir '.[voice,rag]'
ENV PYTHONPATH=/app MODEL_DIR=/models
CMD ["python", "-m", "uvicorn", "apps.voice.main:app", "--host", "0.0.0.0", "--port", "8102"]
