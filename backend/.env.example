# MongoDB (local, solo lectura recomendada)
MONGO_URI=mongodb://127.0.0.1:27017/gueo2021
MONGO_DB=gueo2021

# LLM OpenAI-compatible — OpenCode Go (https://opencode.ai Zen, suscripcion Go)
# Pega tu API key de Go en backend/.env como LLM_API_KEY — NUNCA commitear la key real
LLM_BASE_URL=https://opencode.ai/zen/go/v1
LLM_API_KEY=
# Modelos validos en Go (chat/completions): muse-spark-1.3-contributor (default, razonador 1M contexto),
# kimi-k2.6, kimi-k2.7-code, glm-5.1, glm-5.3, deepseek-v4-pro, qwen3.6-plus
# Lista viva: https://opencode.ai/zen/go/v1/models
LLM_MODEL=deepseek-v4-flash

# Backend
API_PORT=8001
LOG_LEVEL=info

