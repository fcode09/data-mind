# Never commit a populated .env. All data must be synthetic.
DEMO_MODE=true
DATABASE_URL=postgresql://data_mind_app:REPLACE@127.0.0.1:5432/data_mind
DATABASE_ADMIN_URL=postgresql://postgres:REPLACE@127.0.0.1:5432/data_mind
MCP_URL=http://127.0.0.1:8101/mcp
MCP_INTERNAL_TOKEN=REPLACE_WITH_RANDOM_LOCAL_SECRET
VOICE_INTERNAL_TOKEN=REPLACE_WITH_RANDOM_LOCAL_SECRET
API_SESSION_SECRET=REPLACE_WITH_RANDOM_LOCAL_SECRET
VOICE_URL=http://127.0.0.1:8102
# Optional llama.cpp OpenAI-compatible LOCAL endpoint:
# LLAMA_BASE_URL=http://127.0.0.1:8080/v1
# LLAMA_MODEL=qwen3-8b

# Container-only DSNs use the Compose service name, never 127.0.0.1:
COMPOSE_DATABASE_URL=postgresql://data_mind_app:REPLACE@postgres:5432/data_mind
COMPOSE_DATABASE_ADMIN_URL=postgresql://postgres:REPLACE@postgres:5432/data_mind
# Enable only after local embedding model provisioning and SOP ingestion:
# EMBEDDING_URL=http://127.0.0.1:8102/embed
